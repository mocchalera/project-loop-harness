{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-loop-harness.local/contracts/direct-spec-v1.schema.json",
  "title": "Project Loop Harness Direct Setup Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "feature",
    "stories",
    "tests"
  ],
  "properties": {
    "contract_version": {
      "const": "direct-spec/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "surface"],
      "properties": {
        "name": {"type": "string"},
        "surface": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "actor", "goal", "expected_behavior"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "actor": {"type": "string"},
          "goal": {"type": "string"},
          "benefit": {"type": "string"},
          "expected_behavior": {"type": "string"}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "story_ref", "type", "scenario", "expected"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "story_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "manual",
              "smoke",
              "acceptance"
            ]
          },
          "scenario": {"type": "string"},
          "expected": {"type": "string"}
        }
      }
    }
  }
}
