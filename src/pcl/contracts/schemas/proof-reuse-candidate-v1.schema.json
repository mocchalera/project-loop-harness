{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof-reuse-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "candidate_id", "source", "observation", "target", "candidate", "current_proof", "roles", "authorization", "handoff", "effects", "candidate_sha256"],
  "properties": {
    "contract_version": {"const": "proof-reuse-candidate/v1"},
    "candidate_id": {"$ref": "#/$defs/candidate_id"},
    "source": {"$ref": "#/$defs/source"},
    "observation": {"$ref": "#/$defs/observation"},
    "target": {"$ref": "#/$defs/target"},
    "candidate": {"$ref": "#/$defs/git_candidate"},
    "current_proof": {"$ref": "#/$defs/current_proof"},
    "roles": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "authorization": {"$ref": "#/$defs/authorization"},
    "handoff": {"$ref": "#/$defs/handoff"},
    "effects": {"$ref": "#/$defs/effects_success"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^PRC-[0-9A-F]{64}$"},
    "event_id": {"type": "string", "pattern": "^EV-[0-9A-F]{64}$"},
    "public_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,4095}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_event_id", "anchor_event_sequence", "anchor_generation", "anchor_sha256", "manifest_file_sha256", "basis_sha256", "policy_sha256", "coverage_group_sha256", "admission_sha256"],
      "properties": {
        "anchor_event_id": {"$ref": "#/$defs/event_id"},
        "anchor_event_sequence": {"type": "integer", "minimum": 1},
        "anchor_generation": {"type": "integer", "minimum": 0, "maximum": 3},
        "anchor_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "basis_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_group_sha256": {"$ref": "#/$defs/sha256"},
        "admission_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_through_event_sequence", "observed_through_event_id", "observed_through_anchor_event_id"],
      "properties": {
        "observed_through_event_sequence": {"type": "integer", "minimum": 1},
        "observed_through_event_id": {"$ref": "#/$defs/public_id"},
        "observed_through_anchor_event_id": {"$ref": "#/$defs/event_id"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {"type": {"const": "task"}, "id": {"$ref": "#/$defs/public_id"}}
    },
    "git_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_format", "commit_oid", "tree_oid"],
      "properties": {
        "object_format": {"enum": ["sha1", "sha256"]},
        "commit_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "tree_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_format", "commit_oid", "tree_oid"],
            "properties": {
              "object_format": {"const": "sha1"},
              "commit_oid": {},
              "tree_oid": {}
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_format", "commit_oid", "tree_oid"],
            "properties": {
              "object_format": {},
              "commit_oid": {"pattern": "^[0-9a-f]{40}$"},
              "tree_oid": {"pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        {
          "if": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_format", "commit_oid", "tree_oid"],
            "properties": {
              "object_format": {"const": "sha256"},
              "commit_oid": {},
              "tree_oid": {}
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_format", "commit_oid", "tree_oid"],
            "properties": {
              "object_format": {},
              "commit_oid": {"pattern": "^[0-9a-f]{64}$"},
              "tree_oid": {"pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      ]
    },
    "current_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "match_status", "proof_sha256"],
      "properties": {"scope": {"const": "feature"}, "status": {"const": "healthy"}, "match_status": {"const": "matched"}, "proof_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "canary_id", "requirement_sha256", "participant_sha256", "check_id", "plan_sha256", "tool_identity_sha256", "public_execution_sha256", "spawn_vector_sha256", "external_input_binding_sha256", "execution_binding_sha256", "packet_sha256", "final_authority_checkpoint_sha256", "result_sha256", "receipt_sha256", "aggregate_sha256", "bundle_sha256", "verdict", "output_commitment_status", "effect_classification"],
      "properties": {
        "role": {"$ref": "#/$defs/public_id"},
        "kind": {"$ref": "#/$defs/public_id"},
        "canary_id": {"oneOf": [{"$ref": "#/$defs/public_id"}, {"type": "null"}]},
        "requirement_sha256": {"$ref": "#/$defs/sha256"},
        "participant_sha256": {"$ref": "#/$defs/sha256"},
        "check_id": {"$ref": "#/$defs/public_id"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "tool_identity_sha256": {"$ref": "#/$defs/sha256"},
        "public_execution_sha256": {"$ref": "#/$defs/sha256"},
        "spawn_vector_sha256": {"$ref": "#/$defs/sha256"},
        "external_input_binding_sha256": {"$ref": "#/$defs/sha256"},
        "execution_binding_sha256": {"$ref": "#/$defs/sha256"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "final_authority_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "verdict": {"const": "passed"},
        "output_commitment_status": {"const": "committed"},
        "effect_classification": {"const": "read_only"}
      }
    },
    "authorization": {
      "const": {"candidate_recorded": true, "reuse_authorized": false, "direct_input_right": false, "check_skip_authorized": false, "result_substitution_authorized": false, "terminal_authority": false, "lifecycle_authority": false, "mandatory_evidence": false, "promotion_authorized": false, "publication_authorized": false}
    },
    "handoff": {"const": {"status": "durable_candidate", "consumer_enabled": false, "separate_authorization_required": true}},
    "effects_success": {"const": {"schema_version": 8, "migrations_applied": 0, "dependencies_added": 0, "evidence_rows_inserted": 1, "evidence_links_inserted": 1, "events_appended": 1, "outbox_records_appended": 1, "directories_published": 1, "rows_updated": 0, "rows_deleted": 0, "rendered": 0, "lifecycle_transitions": 0, "network_requests": 0}}
  }
}
