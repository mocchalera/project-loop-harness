{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-loop-harness.local/contracts/agent-output-audit-v1.schema.json",
  "title": "Project Loop Harness agent output audit observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observed_at",
    "host",
    "event",
    "tool",
    "classification",
    "reason_code",
    "already_wrapped",
    "action",
    "command_shape_sha256",
    "may_rewrite"
  ],
  "properties": {
    "schema": {"const": "agent-output-audit/v1"},
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "host": {"enum": ["claude-code", "gemini-cli"]},
    "event": {"enum": ["PreToolUse", "BeforeTool"]},
    "tool": {"enum": ["Bash", "run_shell_command"]},
    "classification": {
      "enum": ["eligible", "negative", "unknown", "already_wrapped"]
    },
    "reason_code": {
      "enum": [
        "absolute_path_argv",
        "already_wrapped_pcl_exec",
        "argv_item_too_large",
        "argv_json_too_large",
        "argv_too_large",
        "cargo_build",
        "cargo_clippy",
        "cargo_install",
        "cargo_test",
        "cargo_watch",
        "complete_output",
        "coverage_output_artifact",
        "development_server",
        "empty_argv",
        "eslint",
        "file_read_cat",
        "file_read_head",
        "file_read_sed",
        "file_read_tail",
        "git_diff",
        "git_log",
        "git_show",
        "go_build",
        "go_install",
        "go_test",
        "go_test_all_packages",
        "host_command_string_not_tokenized",
        "interactive_command",
        "interactive_installer",
        "interactive_or_watch_mode",
        "invalid_argv",
        "invalid_argv_json",
        "invalid_policy",
        "malformed_argv_json",
        "malformed_quoting",
        "mypy",
        "npm_install",
        "npm_run_build_script",
        "npm_run_lint_script",
        "npm_run_test_script",
        "npm_run_test_unit_script",
        "npm_run_typecheck_script",
        "npm_run_verify_command",
        "npm_run_verify_script",
        "npm_test",
        "output_is_artifact",
        "pip3_install_non_interactive",
        "pip_install",
        "pip_install_non_interactive",
        "pnpm_install",
        "pnpm_test",
        "pyright",
        "pytest_direct",
        "python3_pip_install_non_interactive",
        "python_http_server",
        "python_module_build",
        "python_module_pytest",
        "python_pip_install",
        "python_pip_install_non_interactive",
        "report_output_artifact",
        "ruff_check",
        "search_find",
        "search_grep",
        "search_rg",
        "secret_shaped_argv",
        "serve_command",
        "server_command",
        "shell_invocation",
        "streaming_command",
        "streaming_tail",
        "tsc_no_emit",
        "unsafe_shell_expression",
        "unsupported_argv",
        "watch_command",
        "watch_or_server_script",
        "yarn_install",
        "yarn_test"
      ]
    },
    "already_wrapped": {"type": "boolean"},
    "action": {"const": "observed_only"},
    "command_shape_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "may_rewrite": {"const": false}
  }
}
