{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-loop.local/contracts/proof-execution-bundle-receipt-v1.schema.json",
  "title": "proof-execution-bundle-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "packet_sha256", "aggregate_sha256", "objects", "bundle_sha256"],
  "properties": {
    "contract_version": {"const": "proof-execution-bundle-receipt/v1"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "aggregate_sha256": {"$ref": "#/$defs/sha256"},
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 1540, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "sha256"],
        "properties": {"role": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\u0001-\\u007f]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
    },
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
